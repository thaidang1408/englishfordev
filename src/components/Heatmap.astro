---
import type { HeatCell } from '../lib/stats/heatmap';

interface Props {
  cells: HeatCell[];
  lessonsDone: number;
  corrections: number;
  repeating: number;
  /** false khi trang đã hiện ba con số ở chỗ khác (đầu trang Hôm nay). */
  stats?: boolean;
}

const { cells, lessonsDone, corrections, repeating, stats = true } = Astro.props;
const activeDays = cells.filter((c) => c.count > 0).length;
const weeks = Math.round(cells.length / 7);
---

<div class:list={['heat', { bare: !stats }]}>
  {stats && <div class="stats">
    <div><b>{lessonsDone}</b><span>bài đã xong</span></div>
    <div><b>{corrections}</b><span>câu đã được sửa</span></div>
    <div><b>{repeating}</b><span>lỗi còn lặp lại</span></div>
  </div>}
  <div class="heat-scroll">
    <div class="heat-grid" role="img" aria-label={`Lịch luyện tập ${weeks} tuần gần nhất: ${activeDays} ngày có luyện tập.`}>
      {
        cells.map((c) => (
          <i
            class:list={[{ future: c.future, [`l${c.level}`]: c.level > 0 }]}
            title={c.future ? undefined : `${c.date}: ${c.count} việc`}
          />
        ))
      }
    </div>
  </div>
  <div class="heat-legend" aria-hidden="true">
    Ít <i style="background:var(--heat-0)"></i><i style="background:var(--heat-1)"></i><i style="background:var(--heat-2)"
    ></i><i style="background:var(--heat-3)"></i><i style="background:var(--heat-4)"></i> Nhiều
  </div>
</div>
