---
/** Trong app: chuyển tiến độ đã học lúc là khách lên tài khoản, một lần (SPEC mục 4). */
---

<script>
  import { migrateGuestProgress } from '../lib/progress/client-sync';

  migrateGuestProgress().then((outcome) => {
    // Trang đang hiện số liệu trước khi chuyển: tải lại một lần. Dữ liệu đã xóa khỏi trình duyệt nên không lặp.
    if (outcome === 'migrated') location.reload();
  });
</script>
