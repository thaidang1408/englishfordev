---
import Base from '../layouts/Base.astro';
import PageHead from './PageHead.astro';

/** Nội dung trang 404, dùng cho 404.astro và cho các trang theo request cần trả 404 (bài không có, /admin). */
---

<Base title="Không tìm thấy trang | English Personal Coach" description="Đường dẫn này không có trang nào." index={false}>
  <PageHead title="Không có trang" highlight="ở đường dẫn này" pill="404" icon="compass" width="narrow" echo="404">
    <p>Có thể link đã cũ hoặc gõ nhầm. Bài 1 vẫn mở cho mọi người.</p>
    <p style="margin-top:var(--s-4)">
      <a class="btn btn-primary" href="/hoc/hom-qua-da-lam-gi">Học thử bài 1, miễn phí</a>
    </p>
  </PageHead>
</Base>
