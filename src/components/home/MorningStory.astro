---
import Icon from '../Icon.astro';

/**
 * "Một buổi sáng 10 phút" kể theo cuộn trang: trên máy tính, khung bên phải đứng yên và đổi màn hình
 * theo bước đang ở giữa màn hình. Trên điện thoại (hoặc không có JS), mỗi bước là một thẻ có hình riêng.
 */
const steps = [
  { icon: 'book', tone: '', title: 'Học một mẫu câu', time: '3 phút', text: 'Công thức, ba ví dụ từ việc của dev, và những lỗi người Việt hay mắc.' },
  { icon: 'keyboard', tone: 'amber', title: 'Làm 5 câu trắc nghiệm', time: '2 phút', text: 'Chọn bằng phím 1, 2, 3. Câu sai được giải thích ngay bằng tiếng Việt.' },
  { icon: 'pen', tone: '', title: 'Viết câu của chính bạn', time: '5 phút', text: 'Viết đúng điều bạn sắp nói trong buổi họp. AI sửa ít nhất có thể, giữ ý của bạn.' },
  { icon: 'repeat', tone: 'amber', title: 'Ôn đúng chỗ bạn sai', time: 'Ngày sau', text: 'Câu sai quay lại sau 1, 3, 7 và 14 ngày. Có nhắc qua Telegram trước giờ standup.' },
] as const;
// 12 tuần minh họa, đậm dần: ôn đều thì lịch kín dần. Cố định, không phải số liệu người dùng.
const heat = Array.from({ length: 84 }, (_, i) => Math.min(4, Math.max(0, Math.floor(i / 17) + ((i * 7) % 5 === 0 ? -1 : (i * 3) % 4 === 0 ? 1 : 0))));
---

<div class="story" data-story data-active="0">
  <ol class="story-steps">
    {
      steps.map((s, i) => (
        <li class="story-step" data-step={i}>
          <div class:list={['card-art', 'story-art', s.tone]} aria-hidden="true">
            <span class="no">0{i + 1}</span>
            {i === 0 && <p class="art-formula" lang="en">Yesterday I + V-ed …</p>}
            {i === 1 && <p class="art-keys"><kbd>1</kbd><kbd>2</kbd><kbd>3</kbd><kbd>Enter</kbd></p>}
            {i === 2 && <p class="art-diff" lang="en"><span class="del">− I fix bug login</span><span class="add">+ I fixed the login bug</span></p>}
            {i === 3 && <p class="art-days"><span>1</span><span>3</span><span>7</span><span>14</span></p>}
          </div>
          <div class="story-text">
            <p class="story-meta"><span class={`tile ${s.tone}`}><Icon name={s.icon} /></span><span class="no">0{i + 1}</span><span class="muted">{s.time}</span></p>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="story-stage" aria-hidden="true">
    <div class="stage-frame">
      <div class="stage-bar"><i></i><i></i><i></i><span>standup-01 · Hôm qua đã làm gì</span></div>
      <div class="stage-body">
        <div class="screen s0">
          <p class="part-label">Phần 1 trên 5 · Mẫu câu</p>
          <p class="formula" lang="en">Yesterday I + V2/ed + object.</p>
          <ul class="examples">
            <li><span class="en" lang="en">Yesterday I fixed the login bug.</span><span class="vi">Hôm qua mình đã sửa bug đăng nhập.</span></li>
            <li><span class="en" lang="en">Yesterday I reviewed two pull requests.</span><span class="vi">Hôm qua mình review hai pull request.</span></li>
          </ul>
        </div>
        <div class="screen s1">
          <p class="part-label">Phần 4 trên 5 · Câu 2 trên 5</p>
          <p class="prompt">Hôm qua mình đã deploy bản sửa lỗi.</p>
          <p class="opt"><kbd>1</kbd><span lang="en">Yesterday I deploy the fix.</span></p>
          <p class="opt pick"><kbd>2</kbd><span lang="en">Yesterday I deployed the fix.</span></p>
          <p class="opt"><kbd>3</kbd><span lang="en">Yesterday I have deployed fix.</span></p>
        </div>
        <div class="screen s2">
          <p class="part-label">Phần 5 trên 5 · Câu của bạn</p>
          <div class="review">
            <div class="diff">
              <div class="diff-line del"><span class="sign">−</span><span lang="en">I already <mark>finish</mark> <mark>task</mark> payment.</span></div>
              <div class="diff-line add"><span class="sign">+</span><span lang="en">I already <mark>finished</mark> <mark>the payment task</mark>.</span></div>
            </div>
            <div class="comment"><span class="avatar">C</span><div><p>Việc đã xong dùng quá khứ. Từ bổ nghĩa đứng trước danh từ.</p></div></div>
          </div>
        </div>
        <div class="screen s3">
          <p class="part-label">Ôn tập · 12 tuần</p>
          <div class="stage-heat">{heat.map((h, i) => <i class={`l${h}`} style={`--d:${i * 12}ms`}></i>)}</div>
          <p class="art-days"><span>1</span><span>3</span><span>7</span><span>14</span></p>
          <p class="muted stage-note">Câu sai hôm nay quay lại vào đúng những ngày này.</p>
        </div>
      </div>
      <div class="stage-dots">{steps.map((_, i) => <i data-dot={i}></i>)}</div>
    </div>
  </div>
</div>

<script>
  const story = document.querySelector<HTMLElement>('[data-story]');
  if (story) {
    story.classList.add('js');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) story.dataset.active = (e.target as HTMLElement).dataset.step ?? '0';
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    story.querySelectorAll('[data-step]').forEach((el) => io.observe(el));
  }
</script>
