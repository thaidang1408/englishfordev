---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { accessFrom, hasFullAccess } from '../lib/auth/access';
import { GROUP_NAMES, LEVEL_NAMES, placement, scorePlacement } from '../lib/content/placement';
import { TRACK_NAMES } from '../lib/content/tracks';
import { TRACKS } from '../lib/content/schema';
import { getEntitlement, getProfile, updateProfile } from '../lib/db/queries';
import { publicEnv } from '../lib/env';
import { sameOrigin } from '../lib/http/response';
import { shuffledIndexes } from '../lib/lesson/shuffle';
import { parseAnswers, trackFormSchema } from '../lib/placement/form';
import { parseRoles } from '../lib/content/roles';
import RolePicker from '../components/RolePicker.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/dang-nhap?next=/xep-trinh-do', 303);
const db = Astro.locals.supabase;
const now = new Date();
const access = accessFrom(await getEntitlement(db, user.id), now);

let error: string | null = null;

if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request, publicEnv().PUBLIC_SITE_URL)) return Astro.redirect('/xep-trinh-do', 303);
  const form = await Astro.request.formData();

  if (form.get('action') === 'track') {
    const parsed = trackFormSchema.safeParse(Object.fromEntries(form));
    // Không tick ngành nào thì giữ nguyên ngành cũ (SPEC mục 16: chưa chọn ngành thì như cũ).
    const ticked = form.getAll('roles').length > 0;
    const roles = ticked ? parseRoles(form) : null;
    if (parsed.success && (!ticked || roles) && (parsed.data.track !== 'interview' || hasFullAccess(access))) {
      await updateProfile(db, user.id, roles ? { track: parsed.data.track, roles } : { track: parsed.data.track });
      return Astro.redirect('/hom-nay', 303);
    }
    error = 'Chưa lưu được. Chọn lại một track và các ngành trong danh sách.';
  } else {
    const answers = parseAnswers(form, placement.questions);
    if (answers) {
      const result = scorePlacement(placement.questions, answers);
      await updateProfile(db, user.id, { level: result.level, weak_area: result.weakArea, track: result.suggestedTrack });
      // Sự kiện phễu (SPEC mục 10). Ghi lỗi thì bỏ qua, không chặn người dùng.
      const logged = await db.from('events').insert({ user_id: user.id, anon_id: null, name: 'placement_complete', props: null });
      if (logged.error) console.error('[xep-trinh-do] event', logged.error.message);
      return Astro.redirect(`/xep-trinh-do?dung=${result.correct}`, 303);
    }
    error = 'Bạn chưa trả lời đủ 12 câu. Mỗi câu chọn một đáp án.';
  }
}

const profile = await getProfile(db, user.id);
const done = Boolean(profile?.level);
const correctParam = Number(Astro.url.searchParams.get('dung'));
const correct = Number.isInteger(correctParam) && correctParam >= 0 && correctParam <= 12 ? correctParam : null;
const tracks = TRACKS.filter((t) => t !== 'interview' || hasFullAccess(access));
const questions = placement.questions.map((q) => ({ ...q, order: shuffledIndexes(q.options.length) }));
---

<Base title="Kiểm tra trình độ | English Personal Coach" description="12 câu, khoảng 5 phút." app>
  {
    done && profile ? (
      <PageHead title="Kết quả" highlight="xếp trình độ" pill="12 câu" icon="target" width="narrow" echo="12">
        <p>Kết quả chỉ dùng để gợi ý track học cho bạn.</p>
      </PageHead>
    ) : (
      <PageHead title="Kiểm tra" highlight="trình độ" pill="12 câu, khoảng 5 phút" icon="target" width="narrow" echo="12">
        <p>Đọc hiểu tin nhắn công việc, chọn câu đúng, chọn cách nói lịch sự hơn. Kết quả dùng để gợi ý track học.</p>
      </PageHead>
    )
  }
  <div class="wrap page narrow">
    {
      done && profile ? (
        <>
          <div class="panel tint">
            {correct !== null && <p class="muted">Bạn đúng {correct} trên 12 câu.</p>}
            <p class="price">{profile.level ? LEVEL_NAMES[profile.level] : ''}</p>
            {profile.weak_area && (
              <p style="margin-top:var(--s-3)">
                Phần cần luyện thêm: <b>{GROUP_NAMES[profile.weak_area]}</b>.
              </p>
            )}
            <p class="muted" style="font-size:var(--fs-sm)">
              Đây không phải trình độ CEFR. Kết quả chỉ dùng để gợi ý track học cho bạn.
            </p>
          </div>

          <form method="post" class="panel">
            <input type="hidden" name="action" value="track" />
            <fieldset class="role-pick">
              <legend>
                <h2 style="font-size:var(--fs-xl)">Bạn đang làm ngành nào?</h2>
              </legend>
              <p class="muted" style="font-size:var(--fs-sm)">Chọn một hoặc nhiều, hoặc để trống. Bài đúng ngành của bạn được đưa lên trước, đổi lại được ở trang Tài khoản.</p>
              <RolePicker selected={profile.roles} />
            </fieldset>
            <fieldset style="border:0;padding:0;margin:0">
              <legend>
                <h2 style="font-size:var(--fs-xl)">Chọn track để bắt đầu</h2>
              </legend>
              <div class="lessons" style="margin-top:var(--s-3)">
                {tracks.map((t) => (
                  <label class="lrow" style="grid-template-columns:auto 1fr auto;cursor:pointer">
                    <input type="radio" name="track" value={t} checked={profile.track === t} required />
                    <span>
                      <b>{TRACK_NAMES[t]}</b>
                    </span>
                    {profile.track === t && <span class="tag free">Gợi ý</span>}
                  </label>
                ))}
              </div>
            </fieldset>
            {error && <p class="note err" role="alert">{error}</p>}
            <button class="btn btn-primary" type="submit" style="margin-top:var(--s-5)">Bắt đầu học</button>
          </form>
        </>
      ) : (
        <>
          {error && <p class="note err" role="alert">{error}</p>}
          <form method="post" class="stack">
            <input type="hidden" name="action" value="answers" />
            {questions.map((q, i) => (
              <fieldset class="quiz" style="margin-inline:0">
                <legend class="sr-only-label">Câu {i + 1}</legend>
                <p class="quiz-top">Câu {i + 1} trên 12</p>
                {q.context_en && (
                  <blockquote lang="en" class="formula" style="font-size:var(--fs-md);font-weight:500;margin-top:0">
                    {q.context_en}
                  </blockquote>
                )}
                <p class="prompt">{q.prompt_vi}</p>
                {q.order.map((original) => (
                  <label class="opt">
                    <input type="radio" name={q.id} value={original} required />
                    <span lang={q.group === 'reading' ? 'vi' : 'en'} style={q.group === 'reading' ? 'font-family:var(--font-sans)' : undefined}>
                      {q.options[original]}
                    </span>
                    <span class="opt-mark">{''}</span>
                  </label>
                ))}
              </fieldset>
            ))}
            <div>
              <button class="btn btn-primary" type="submit">Xem kết quả</button>
            </div>
          </form>
        </>
      )
    }
  </div>
</Base>
