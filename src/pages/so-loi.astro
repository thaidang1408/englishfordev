---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ErrorBook from '../components/ErrorBook.astro';
import { accessFrom, hasFullAccess } from '../lib/auth/access';
import { getCorrections } from '../lib/db/corrections';
import { countRepeatingErrors, getEntitlement } from '../lib/db/queries';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/dang-nhap?next=/so-loi', 303);
const db = Astro.locals.supabase;
const now = new Date();

const [ent, entries, repeating] = await Promise.all([
  getEntitlement(db, user.id),
  getCorrections(db, user.id, { limit: 500 }),
  countRepeatingErrors(db, user.id),
]);
const full = hasFullAccess(accessFrom(ent, now));
---

<Base title="Sổ lỗi | English Personal Coach" description="Lỗi trong câu của chính bạn và nhóm lỗi hay mắc." app>
  <PageHead title="Sổ lỗi" highlight="của chính bạn" pill="28 ngày gần nhất" icon="diff" width="narrow" echo="SỔ LỖI">
    <p>Mỗi chỗ AI sửa trong câu của bạn được xếp vào một nhóm lỗi. Lỗi đang lặp lại quay lại trong phần ôn.</p>
  </PageHead>
  <div class="wrap page narrow book-page">
    <ErrorBook entries={entries} repeating={repeating} full={full} now={now} />
  </div>
</Base>
