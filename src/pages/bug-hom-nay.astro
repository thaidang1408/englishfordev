---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ReviewDiff from '../components/ReviewDiff.astro';
import BugGame, { type BugLine } from '../components/bug/BugGame';
import { bugsForDate, practiceBugs, type DailyBug } from '../lib/bug/daily';
import { MAX_TRIES, prNumber } from '../lib/bug/share';
import { lessons } from '../lib/content/lessons';
import { formatVnDate, vnDateKey } from '../lib/time';

// Mỗi ngày một PR theo giờ Việt Nam nên render theo request, không build sẵn.
export const prerender = false;

const now = new Date();
const date = vnDateKey(now);
// Bài miễn phí có trang học; bài khác dẫn sang trang mẫu câu, từ đó vào bài học.
const toLine = (b: DailyBug): BugLine => ({
  wrong: b.wrong,
  right: b.right,
  right_vi: b.right_vi,
  why_vi: b.why_vi,
  words: b.words,
  targets: b.targets,
  title: b.lesson.title,
  href: b.lesson.free ? `/hoc/${b.lesson.slug}` : `/mau-cau/${b.lesson.slug}`,
});
const bugs = bugsForDate(lessons, date).map(toLine);
const practice = practiceBugs(lessons, date).map(toLine);
// src để biết lượt vào trang đến từ kết quả được chia sẻ (SPEC mục 10).
const shareUrl = new URL('/bug-hom-nay?src=bug-share', Astro.site).href;
---

<Base
  title="Tìm lỗi mỗi ngày: review 3 câu tiếng Anh dev hay viết sai | EPC"
  description={`Mỗi ngày một PR có 3 câu tiếng Anh dev hay viết sai. Bấm vào chữ sai, mỗi dòng ${MAX_TRIES} lần thử, xem giải thích bằng tiếng Việt.`}
>
  <PageHead title="Tìm lỗi" highlight="mỗi ngày" pill={`PR ${prNumber(date)} · ${formatVnDate(now)}`} icon="target" width="narrow" echo="BUG">
    <p>
      Bạn là reviewer. Mỗi ngày một pull request có 3 dòng tiếng Anh, mỗi dòng một lỗi dev người Việt hay mắc. Bấm vào chữ sai, tìm
      càng sớm càng nhiều điểm.
    </p>
  </PageHead>
  <div class="wrap page narrow">
    {
      bugs.length === 0 ? (
        <p class="muted" style="margin-top:var(--s-3)">Hôm nay chưa có PR nào. Quay lại vào ngày mai.</p>
      ) : (
        <>
          <ul class="pr-rules">
            <li><b>3 điểm</b> nếu bắt được ở lần đầu, 2 ở lần hai, 1 ở lần ba.</li>
            <li><b>Approve</b> khi đủ 9 điểm. Chơi mỗi ngày để giữ chuỗi.</li>
            <li>Lỗi thiếu từ thì bấm vào chữ đứng ngay sau chỗ thiếu.</li>
          </ul>
          <BugGame client:load date={date} bugs={bugs} practice={practice} url={shareUrl} />
          {/* Không có JavaScript thì không chơi được: cho xem đáp án. Có JavaScript thì khối này tự ẩn. */}
          <details class="pr-answers" id="pr-answers">
            <summary>Không chơi được? Xem đáp án PR hôm nay</summary>
            {bugs.map((b, k) => (
              <div style="margin-top:var(--s-4)">
                <ReviewDiff before={b.wrong} after={b.right} headLeft={`Dòng ${k + 1}: ${b.title}`}>
                  <p class="vi-line">Nghĩa: {b.right_vi}</p>
                  <p>{b.why_vi}</p>
                </ReviewDiff>
              </div>
            ))}
          </details>
          <script is:inline>document.getElementById('pr-answers').hidden = true;</script>
        </>
      )
    }
  </div>
</Base>
