---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { parseAccountForm } from '../lib/account/form';
import { accessFrom } from '../lib/auth/access';
import { getEntitlement, getProfile, updateProfile } from '../lib/db/queries';
import { publicEnv } from '../lib/env';
import { sameOrigin } from '../lib/http/response';
import { daysLeft, formatVnDate } from '../lib/time';
import { serverEnv } from '../lib/env-server';
import { startLink } from '../lib/telegram/bot';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/dang-nhap?next=/tai-khoan', 303);
const db = Astro.locals.supabase;
const now = new Date();
let error: string | null = null;

if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request, publicEnv().PUBLIC_SITE_URL)) return Astro.redirect('/tai-khoan', 303);
  const patch = parseAccountForm(await Astro.request.formData(), now);
  if (patch) {
    await updateProfile(db, user.id, patch);
    return Astro.redirect('/tai-khoan?da-luu', 303);
  }
  error = 'Chưa lưu được. Kiểm lại giờ standup, và ngày phỏng vấn phải trong vòng một năm tới.';
}

const [profile, ent] = await Promise.all([getProfile(db, user.id), getEntitlement(db, user.id)]);
const access = accessFrom(ent, now);
const saved = Astro.url.searchParams.has('da-luu');
const standup = profile?.standup_time.slice(0, 5) ?? '09:00';
const bot = serverEnv().TELEGRAM_BOT_USERNAME;
const linked = profile?.telegram_chat_id != null;
// Mã liên kết là bí mật của riêng tài khoản này; trang không cache (middleware đặt no-store).
const telegramHref = bot && profile?.telegram_link_token ? startLink(bot, profile.telegram_link_token) : null;
---

<Base title="Tài khoản | English Personal Coach" description="Giờ standup, ngày phỏng vấn, gói đang dùng." app>
  <PageHead title="Tài khoản" pill={user.email ?? 'Tài khoản của bạn'} icon="user" echo="EPC">
    <p>Gói đang dùng, lịch học và nhắc qua Telegram.</p>
  </PageHead>
  <div class="wrap page">
    <div class="grid-2">

    <section class="panel" aria-labelledby="goi">
      <div class="panel-head"><span class="tile amber"><Icon name="card" /></span><h2 id="goi">Gói đang dùng</h2></div>
      <div>
        {
          access.kind === 'premium' && (
            <p style="margin:0">
              <b>Premium</b> tới hết ngày {formatVnDate(access.until)}, còn {daysLeft(access.until, now)} ngày.{' '}
              <a href="/nang-cap">Mua thêm ngày</a>
            </p>
          )
        }
        {
          access.kind === 'trial' && (
            <p style="margin:0">
              <b>Dùng thử</b> đủ quyền Premium tới {formatVnDate(access.until)}, còn {daysLeft(access.until, now)} ngày.{' '}
              <a href="/nang-cap">Xem gói Premium</a>
            </p>
          )
        }
        {
          access.kind === 'free' && (
            <p style="margin:0">
              <b>Miễn phí.</b> {access.trialEndedAt && `Dùng thử đã hết ngày ${formatVnDate(access.trialEndedAt)}.`} Dữ liệu của bạn vẫn còn nguyên. <a href="/nang-cap">Nâng cấp</a>
            </p>
          )
        }
      </div>
    </section>

    <section class="panel" aria-labelledby="telegram">
      <div class="panel-head"><span class="tile"><Icon name="send" /></span><h2 id="telegram">Nhắc qua Telegram</h2></div>
      {
        linked ? (
          <>
            <p class="note ok" style="margin-top:var(--s-3)">
              Đã liên kết. Từ thứ Hai đến thứ Sáu, bot nhắc bạn trước {standup} từ 30 đến 45 phút, nếu hôm đó bạn chưa học bài.
              {access.kind !== 'free' && ' Tối Chủ nhật 20:00 bạn nhận báo cáo tuần.'}
            </p>
            <p style="font-size:var(--fs-sm)">
              Gửi cho bot một câu tiếng Anh bạn sắp viết trên Slack, Jira hay email, bot sửa và giải thích bằng tiếng Việt. Mỗi lần
              tính một lượt sửa, lỗi vào sổ lỗi như khi sửa trên web.
            </p>
            <p class="muted" style="font-size:var(--fs-sm)">Cần hỗ trợ, gõ /hotro kèm nội dung. Muốn tắt, gõ /stop.</p>
          </>
        ) : telegramHref ? (
          <>
            <p>
              Bot nhắc bạn học trước giờ standup, mỗi ngày tối đa một tin. Bạn cũng gửi câu tiếng Anh cho bot để sửa ngay trong
              Telegram. Premium có thêm báo cáo tuần.
            </p>
            <a class="btn btn-quiet" href={telegramHref} rel="noopener">
              Liên kết Telegram
            </a>
            <p class="muted" style="font-size:var(--fs-sm);margin-top:var(--s-3)">
              Telegram mở chat với bot, bạn bấm Start. Xong thì tải lại trang này.
            </p>
          </>
        ) : (
          <p class="muted">Nhắc qua Telegram đang tạm tắt.</p>
        )
      }
    </section>

    <section class="panel" aria-labelledby="lich">
      <div class="panel-head"><span class="tile"><Icon name="clock" /></span><h2 id="lich">Lịch học</h2></div>
      {saved && <p class="note ok" role="status">Đã lưu.</p>}
      {error && <p class="note err" role="alert">{error}</p>}
      <form method="post" style="margin-top:var(--s-4)">
        <label class="field">
          <span>Giờ họp standup</span>
          <small class="muted">Lời nhắc qua Telegram gửi trước giờ này 30 đến 45 phút, thứ Hai đến thứ Sáu.</small>
          <input type="time" name="standup_time" value={standup} required />
        </label>
        <label class="field">
          <span>Ngày phỏng vấn <small class="muted">(không bắt buộc)</small></span>
          <small class="muted">Có ngày phỏng vấn thì trang Hôm nay đếm ngược và gợi ý track Phỏng vấn.</small>
          <input type="date" name="interview_date" value={profile?.interview_date ?? ''} />
        </label>
        <button class="btn btn-primary" type="submit">Lưu lịch học</button>
      </form>
    </section>


    <section class="panel" aria-labelledby="dang-xuat">
      <div class="panel-head"><span class="tile amber"><Icon name="logout" /></span><h2 id="dang-xuat">Đăng xuất</h2></div>
      <p class="muted">Dữ liệu học vẫn còn trong tài khoản. Lần sau đăng nhập bằng đúng tài khoản Google hoặc GitHub này.</p>
      <form method="post" action="/auth/signout">
        <button class="btn btn-quiet" type="submit">Đăng xuất</button>
      </form>
    </section>
    </div>
  </div>
</Base>
