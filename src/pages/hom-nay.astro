---
import Base from '../layouts/Base.astro';
import Heatmap from '../components/Heatmap.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import CorrectBox from '../components/correct/CorrectBox';
import UpgradeCard from '../components/UpgradeCard.astro';
import { getErrorStats } from '../lib/db/corrections';
import { showTodayCard } from '../lib/pay/upsell';
import { daysUntil } from '../lib/notify/schedule';
import { accessFrom, hasFullAccess } from '../lib/auth/access';
import { lessons } from '../lib/content/lessons';
import { lessonKey } from '../lib/content/schema';
import { TRACK_NAMES, TRACK_OUTLINE } from '../lib/content/tracks';
import {
  countCorrections,
  countDueReviews,
  countRepeatingErrors,
  getCorrectionTimes,
  getEntitlement,
  getLessonProgress,
  getProfile,
} from '../lib/db/queries';
import { lessonOfTheDay } from '../lib/lesson/today';
import { SESSION_SIZE } from '../lib/review/leitner';
import { buildHeatmap } from '../lib/stats/heatmap';
import { addDaysTo, daysLeft, formatVnDate } from '../lib/time';

export const prerender = false;

const WEEKS = 16;
const user = Astro.locals.user;
if (!user) return Astro.redirect('/dang-nhap?next=/hom-nay', 303);
const db = Astro.locals.supabase;
const now = new Date();

const [profile, ent] = await Promise.all([getProfile(db, user.id), getEntitlement(db, user.id)]);
if (!profile?.level) return Astro.redirect('/xep-trinh-do', 303);
const access = accessFrom(ent, now);

const [progress, due, repeating, correctionCount, correctionTimes] = await Promise.all([
  getLessonProgress(db, user.id),
  countDueReviews(db, user.id, now, hasFullAccess(access) ? ['quiz', 'own_error'] : ['quiz']),
  countRepeatingErrors(db, user.id),
  countCorrections(db, user.id),
  getCorrectionTimes(db, user.id, addDaysTo(now, -WEEKS * 7)),
]);

const done = new Map(progress.map((p) => [p.lesson_key, p]));
// Đếm ngược phỏng vấn (SPEC mục 5b): có ngày phỏng vấn chưa qua thì hiện và gợi ý track Phỏng vấn.
const interviewIn = profile.interview_date ? daysUntil(profile.interview_date, now) : null;
const today = lessonOfTheDay(lessons, profile.track, new Set(done.keys()), now);
const cells = buildHeatmap([...progress.map((p) => new Date(p.completed_at)), ...correctionTimes], now, WEEKS);

const rows = TRACK_OUTLINE[profile.track].map((title, i) => {
  const id = i + 1;
  const lesson = lessons.find((l) => l.track === profile.track && l.id === id);
  const key = lessonKey({ track: profile.track, id });
  const result = done.get(key);
  const locked = !lesson?.free && !hasFullAccess(access);
  const isToday = today.kind === 'lesson' && today.lesson.id === id;
  // Bài bị khóa vẫn dẫn tới trang bài, nơi hiện lời mời nâng cấp (SPEC mục 2).
  const href = lesson ? `/hoc/${lesson.slug}` : undefined;
  return { id, title, formula: lesson?.pattern.formula, result, locked, isToday, href };
});
const doneInTrack = rows.filter((r) => r.result).length;
const pct = Math.round((doneInTrack / rows.length) * 100);
// Mỗi màn hình một nút tím: khi không có bài để học hôm nay thì ôn tập là việc chính.
const todayOpen = today.kind === 'lesson' && (today.lesson.free || hasFullAccess(access));
const reviewIsMain = !todayOpen;
// Thẻ mời nâng cấp từ ngày thứ 5 của dùng thử (SPEC mục 2), với số liệu thật của người dùng.
const upsell = showTodayCard(access, now) ? await getErrorStats(db, user.id) : null;
const PLAN_LABEL = { premium: 'Premium', trial: 'Dùng thử', free: 'Miễn phí' } as const;
// Ba bước đầu cho người mới, đánh dấu theo dữ liệu thật; làm đủ thì ẩn.
const steps = [
  { done: progress.length > 0, label: 'Học một bài 10 phút', href: today.kind === 'lesson' ? `/hoc/${today.lesson.slug}` : '/#bai-hoc' },
  { done: correctionCount > 0, label: 'Viết một câu tiếng Anh và nhờ AI sửa', href: '#sua-cau' },
  { done: profile.telegram_chat_id != null, label: 'Bật nhắc học qua Telegram', href: '/tai-khoan#telegram' },
];
const stepsLeft = steps.filter((s) => !s.done).length;
---

<Base title="Hôm nay | English Personal Coach" description="Bài của ngày và câu cần ôn." app>
  <PageHead
    title={profile.display_name ? `Chào ${profile.display_name},` : 'Hôm nay'}
    highlight={profile.display_name ? 'hôm nay học gì?' : undefined}
    pill={formatVnDate(now)}
    icon="calendar"
    echo="HÔM NAY"
  >
    <p>
      Track {TRACK_NAMES[profile.track]}, đã xong {doneInTrack} trên {rows.length} bài.{' '}
      <span class:list={['plan-badge', access.kind]}>{PLAN_LABEL[access.kind]}</span>
    </p>
    <div slot="aside" class="stat-tiles head-stats">
      <div class="stat-tile"><b>{progress.length}</b><span>bài đã xong</span></div>
      <div class="stat-tile"><b>{correctionCount}</b><span>câu đã được sửa</span></div>
      <div class="stat-tile"><b>{repeating}</b><span>lỗi còn lặp lại</span></div>
    </div>
  </PageHead>

  <div class="wrap page">
    {
      interviewIn !== null && (
        <div class="countdown" role="status">
          <p>
            <b>{interviewIn === 0 ? 'Hôm nay là buổi phỏng vấn.' : `Còn ${interviewIn} ngày tới buổi phỏng vấn.`}</b>{' '}
            {/* Track Phỏng vấn chỉ mở cho Premium và dùng thử, nên chỉ gợi ý khi chọn được. */}
            {hasFullAccess(access) &&
              (profile.track !== 'interview' ? (
                <>
                  Gợi ý: học track Phỏng vấn trong những ngày này. <a href="/xep-trinh-do">Đổi track</a>
                </>
              ) : (
                <a href="/phong-van-thu">Phỏng vấn thử 5 câu</a>
              ))}
          </p>
        </div>
      )
    }

    {
      stepsLeft > 0 && (
        <section class="panel tint start-steps" aria-labelledby="bat-dau">
          <div class="panel-head">
            <span class="tile"><Icon name="compass" /></span>
            <div>
              <h2 id="bat-dau">Bắt đầu trong 3 bước</h2>
              <p>Xong {steps.length - stepsLeft} trên {steps.length}. Mục này tự ẩn khi bạn làm đủ.</p>
            </div>
          </div>
          <ol>
            {steps.map((s, i) => (
              <li class:list={{ done: s.done }}>
                <span class="step-no">{s.done ? <Icon name="check" size={16} /> : i + 1}</span>
                {s.done ? <s>{s.label}</s> : <a href={s.href}>{s.label}</a>}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <div class="grid-dash">
      <div>
        <section class="panel" aria-labelledby="bai-hom-nay">
          <div class="panel-head">
            <span class="tile"><Icon name="book" /></span>
            <h2 id="bai-hom-nay">Bài hôm nay</h2>
          </div>
          {
            today.kind === 'lesson' && (
              <div class="today-hero">
                <div>
                  <p class="muted" style="font-size:var(--fs-sm);margin:0">
                    {TRACK_NAMES[profile.track]}, bài <span class="num">{String(today.lesson.id).padStart(2, '0')}</span>
                  </p>
                  <h3>{today.lesson.title}</h3>
                  <p class="muted" style="margin:0">{today.lesson.goal_vi}</p>
                  <div class="today-actions">
                    {todayOpen ? (
                      <a class="btn btn-primary" href={`/hoc/${today.lesson.slug}`}>
                        Học bài hôm nay
                        <Icon name="arrow" size={18} />
                      </a>
                    ) : (
                      <p class="note info" style="margin:0">
                        Bài này cần Premium. <a href={`/hoc/${today.lesson.slug}`}>Xem bài</a>
                      </p>
                    )}
                    <span class="muted when-chip">
                      <Icon name="clock" size={16} />
                      Khoảng 10 phút
                    </span>
                  </div>
                </div>
                <div class="today-art" aria-hidden="true">
                  <div>
                    <span class="no">{String(today.lesson.id).padStart(2, '0')}</span>
                    <span lang="en">{today.lesson.pattern.formula}</span>
                  </div>
                </div>
              </div>
            )
          }
          {today.kind === 'weekend' && <p style="margin:0">Cuối tuần không có bài mới. Hôm nay dành để ôn những câu đến hạn.</p>}
          {
            today.kind === 'track_done' && (
              <p style="margin:0">
                Bạn đã học hết track {TRACK_NAMES[profile.track]}. <a href="/xep-trinh-do">Chọn track khác</a>
              </p>
            )
          }
          {
            today.kind === 'empty' && (
              <p style="margin:0">
                Track {TRACK_NAMES[profile.track]} đang được soạn bài. Trong lúc chờ, bạn có thể học track Standup và họp.{' '}
                <a href="/xep-trinh-do">Đổi track</a>
              </p>
            )
          }
        </section>

        <section class="panel" aria-labelledby="sua-cau">
          <div class="panel-head">
            <span class="tile amber"><Icon name="pen" /></span>
            <div>
              <h2 id="sua-cau">Nhờ AI sửa câu</h2>
              <p>Câu bạn sắp nói ở standup, viết trên Slack hay trong pull request.</p>
            </div>
          </div>
          <noscript><p class="note warn">Phần sửa câu cần bật JavaScript.</p></noscript>
          <CorrectBox client:visible next="/hom-nay" />
          {
            hasFullAccess(access) && (
              <p style="margin:var(--s-4) 0 0;font-size:var(--fs-sm)">
                Sắp phỏng vấn? <a href="/phong-van-thu">Phỏng vấn thử 5 câu</a>
              </p>
            )
          }
        </section>
      </div>

      <div>
        <section class:list={['panel', { tint: due > 0 }]} aria-labelledby="can-on">
          <div class="panel-head">
            <span class="tile"><Icon name="repeat" /></span>
            <h2 id="can-on">Cần ôn hôm nay</h2>
          </div>
          {
            due > 0 ? (
              <>
                <p class="big-num">
                  {due}
                  <small>câu đến hạn</small>
                </p>
                <a class:list={['btn', reviewIsMain ? 'btn-primary' : 'btn-quiet']} href="/on-tap" style="margin-top:var(--s-4)">
                  Ôn {Math.min(due, SESSION_SIZE)} câu
                  <Icon name="arrow" size={18} />
                </a>
              </>
            ) : (
              <p class="muted" style="margin:0">Chưa có câu nào đến hạn ôn. Câu sai hôm nay sẽ quay lại vào ngày mai.</p>
            )
          }
          <p class="muted" style="font-size:var(--fs-xs);margin:var(--s-4) 0 var(--s-2)">Câu sai quay lại sau</p>
          <div class="ladder" aria-label="1, 3, 7 và 14 ngày">
            <span>1</span><i></i><span>3</span><i></i><span>7</span><i></i><span>14</span>
          </div>
        </section>

        {
          upsell && (
            <section aria-label="Nâng cấp Premium">
              <UpgradeCard
                stats={upsell}
                fallback={access.kind === 'trial' ? `Dùng thử còn ${daysLeft(access.until, now)} ngày` : 'Dùng thử đã hết, dữ liệu của bạn vẫn còn'}
                primary={false}
              />
            </section>
          )
        }

        <section class="panel" aria-labelledby="so-loi-tat">
          <div class="panel-head">
            <span class="tile amber"><Icon name="diff" /></span>
            <h2 id="so-loi-tat">Sổ lỗi</h2>
            <a class="go" href="/so-loi">Mở sổ lỗi <span class="go-dot"><Icon name="arrow" size={16} /></span></a>
          </div>
          <p class="muted" style="margin:0">
            {repeating > 0 ? `${repeating} lỗi trong câu của bạn đang lặp lại.` : 'Chưa có lỗi nào đang lặp lại.'} Mỗi chỗ AI sửa được xếp
            vào một nhóm lỗi.
          </p>
        </section>
      </div>
    </div>

    <section class="panel" aria-labelledby="luyen-tap">
      <div class="panel-head">
        <span class="tile"><Icon name="calendar" /></span>
        <h2 id="luyen-tap">Lịch luyện tập</h2>
        <p class="panel-end">{WEEKS} tuần gần nhất</p>
      </div>
      <Heatmap cells={cells} lessonsDone={progress.length} corrections={correctionCount} repeating={repeating} stats={false} />
    </section>

    <section class="panel" aria-labelledby="tien-do">
      <div class="panel-head">
        <span class="tile amber"><Icon name="target" /></span>
        <h2 id="tien-do">{TRACK_NAMES[profile.track]}</h2>
        <a class="go" href="/xep-trinh-do">Đổi track <span class="go-dot"><Icon name="arrow" size={16} /></span></a>
      </div>
      <div class="progress-meta"><span>Đã xong {doneInTrack} trên {rows.length} bài</span><span>{pct}%</span></div>
      <div class="progress" role="progressbar" aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ track">
        <i style={`width:${pct}%`}></i>
      </div>
      <div class="lessons cols" style="margin-top:var(--s-4)">
        {
          rows.map((r) => {
            const inner = (
              <>
                <span class="num">{String(r.id).padStart(2, '0')}</span>
                <span>
                  <b>{r.title}</b>
                  {r.formula && <small lang="en">{r.formula}</small>}
                </span>
                {r.result ? (
                  <span class="tag done">Đúng {r.result.score} trên 5</span>
                ) : r.isToday ? (
                  <span class="tag today">Hôm nay</span>
                ) : r.locked ? (
                  <span class="tag lock">Premium</span>
                ) : (
                  <span class="tag lock">Chưa học</span>
                )}
              </>
            );
            return r.href ? (
              <a class="lrow" href={r.href}>
                {inner}
              </a>
            ) : (
              <div class:list={['lrow', { locked: r.locked }]}>{inner}</div>
            );
          })
        }
      </div>
    </section>
  </div>
</Base>
