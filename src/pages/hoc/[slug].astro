---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import LessonView from '../../components/LessonView.astro';
import { lessons } from '../../lib/content/lessons';
import type { Lesson } from '../../lib/content/schema';

// Bài miễn phí render sẵn HTML. Bài Premium do hoc/[...slug].astro render theo request, có kiểm quyền.
export const getStaticPaths = (() =>
  lessons.filter((l) => l.free).map((lesson) => ({ params: { slug: lesson.slug }, props: { lesson } }))) satisfies GetStaticPaths;

interface Props {
  lesson: Lesson;
}

const { lesson } = Astro.props;
const num = String(lesson.id).padStart(2, '0');
---

<Base
  title={`Bài ${num}: ${lesson.title} | English Personal Coach`}
  description={`${lesson.goal_vi} Bài học 10 phút cho dev: mẫu câu, ví dụ, lỗi hay gặp và trắc nghiệm.`}
>
  <LessonView lesson={lesson} />
</Base>
