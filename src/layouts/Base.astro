---
// Font tự host: unicode-range trong mỗi file để trình duyệt chỉ tải subset latin và vietnamese cần dùng.
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/600.css';
import '@fontsource/be-vietnam-pro/800.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';
import ProgressSync from '../components/ProgressSync.astro';
import Icon from '../components/Icon.astro';
import { serverEnv } from '../lib/env-server';
import { accessFrom } from '../lib/auth/access';
import { getEntitlement } from '../lib/db/queries';

interface Props {
  title: string;
  description: string;
  /** Đặt false cho trang không được index (404, trang cần đăng nhập). */
  index?: boolean;
  /** Dữ liệu có cấu trúc JSON-LD, đã là object thuần. */
  jsonLd?: Record<string, unknown>;
  /** Trang trong app, cần đăng nhập: thanh điều hướng riêng, không index. */
  app?: boolean;
}

const { title, description, jsonLd, app = false } = Astro.props;
const index = app ? false : (Astro.props.index ?? true);
// Trang tĩnh có thể có dấu / ở cuối; bỏ đi để so với link.
const path = Astro.url.pathname.replace(/(.)\/$/, '$1');

// Trang trong app render theo request nên biết người dùng; trang tĩnh thì không, Astro.locals.user là undefined.
const user = app ? Astro.locals.user : null;
const isAdmin = Boolean(user?.email && serverEnv().ADMIN_EMAILS.includes(user.email.toLowerCase()));
// Người đã có Premium không cần thấy nút Nâng cấp.
const isPremium = user ? accessFrom(await getEntitlement(Astro.locals.supabase, user.id), new Date()).kind === 'premium' : false;

type NavLink = { href: string; label: string; match?: string[] };
const links: NavLink[] = app
  ? [
      { href: '/hom-nay', label: 'Học hôm nay' },
      { href: '/on-tap', label: 'Ôn tập' },
      { href: '/so-loi', label: 'Sổ lỗi' },
      { href: '/phong-van-thu', label: 'Phỏng vấn thử' },
      { href: '/tai-khoan', label: 'Tài khoản', match: ['/xep-trinh-do'] },
      ...(isAdmin ? [{ href: '/admin', label: 'Admin' }] : []),
    ]
  : [
      { href: '/#bai-hoc', label: 'Bài học', match: ['/hoc/', '/mau-cau/'] },
      { href: '/bug-hom-nay', label: 'Tìm lỗi mỗi ngày' },
      { href: '/bang-gia', label: 'Bảng giá' },
    ];
// Trang công khai không biết ai đã đăng nhập: /hom-nay tự chuyển người mới sang đăng nhập, người cũ vào học luôn.
// Thanh tab dưới đáy (điện thoại, trang trong app): nhãn ngắn, có icon.
const tabs: (NavLink & { icon: 'book' | 'repeat' | 'diff' | 'mic' | 'user' })[] = [
  { href: '/hom-nay', label: 'Học', icon: 'book' },
  { href: '/on-tap', label: 'Ôn tập', icon: 'repeat' },
  { href: '/so-loi', label: 'Sổ lỗi', icon: 'diff' },
  { href: '/phong-van-thu', label: 'Phỏng vấn', icon: 'mic' },
  { href: '/tai-khoan', label: 'Tài khoản', icon: 'user', match: ['/xep-trinh-do', '/nang-cap'] },
];
const cta = app ? (isPremium ? null : { href: '/nang-cap', label: 'Nâng cấp' }) : { href: '/hom-nay', label: 'Học miễn phí' };
const isCurrent = (l: NavLink) => path === l.href || (l.match ?? []).some((m) => path.startsWith(m));
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="English Personal Coach" />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Khung sửa câu: I fixed bug login yesterday thành Yesterday I fixed the login bug." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfcfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10151d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Đặt giao diện trước khi vẽ để không nháy màu. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('epc:theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {
      jsonLd && (
        // Nội dung của chính site, đã thoát dấu < để không đóng thẻ script sớm.
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
      )
    }
  </head>
  <body class:list={{ 'has-tabbar': app }}>
    <a class="skip" href="#noi-dung">Bỏ qua, tới nội dung chính</a>
    <header class="topbar">
      <div class="wrap bar">
        <a class="brand" href={app ? '/hom-nay' : '/'} aria-label={app ? 'English Personal Coach, trang Hôm nay' : 'English Personal Coach, trang chủ'}>
          <span class="logo" aria-hidden="true"><i></i><i></i></span>
          <b class="brand-full">English Personal Coach</b>
          <b class="brand-short" aria-hidden="true">EPC</b>
        </a>
        <nav class="nav" aria-label="Điều hướng chính">
          {links.map((l) => <a href={l.href} aria-current={isCurrent(l) ? 'page' : undefined}>{l.label}</a>)}
        </nav>
        <div class="bar-end">
          <button class="theme" id="theme-toggle" type="button" hidden><span class="theme-prefix">Giao diện </span><span class="theme-word">tối</span></button>
          {
            cta && (
              <a class="btn btn-quiet btn-sm bar-cta" href={cta.href} aria-current={path === cta.href ? 'page' : undefined}>
                {cta.label}
                <Icon name="arrow" size={16} />
              </a>
            )
          }
          <details class="menu">
            <summary><Icon name="menu" size={18} /><span>Menu</span></summary>
            <nav class="menu-panel" aria-label="Menu">
              {links.map((l) => <a href={l.href} aria-current={isCurrent(l) ? 'page' : undefined}>{l.label}</a>)}
              {cta && <a href={cta.href} aria-current={path === cta.href ? 'page' : undefined}>{cta.label}</a>}
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="noi-dung">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div class="foot-about">
          <a class="brand" href="/" aria-label="English Personal Coach, trang chủ">
            <span class="logo" aria-hidden="true"><i></i><i></i></span>
            <b>English Personal Coach</b>
          </a>
          <p>Tiếng Anh cho công việc của dev, 10 phút mỗi sáng. Do một lập trình viên tự làm.</p>
        </div>
        <nav aria-label="Học">
          <h2>Học</h2>
          <ul>
            <li><a href="/hoc/hom-qua-da-lam-gi">Học thử bài 1</a></li>
            <li><a href="/#bai-hoc">Danh sách bài học</a></li>
            <li><a href="/bug-hom-nay">Tìm lỗi mỗi ngày</a></li>
            <li><a href="/hom-nay">Học hôm nay</a></li>
            <li><a href="/on-tap">Ôn tập</a></li>
          </ul>
        </nav>
        <nav aria-label="Tài khoản">
          <h2>Tài khoản</h2>
          <ul>
            <li><a href="/so-loi">Sổ lỗi</a></li>
            <li><a href="/phong-van-thu">Phỏng vấn thử</a></li>
            <li><a href="/xep-trinh-do">Kiểm tra trình độ</a></li>
            <li><a href="/tai-khoan">Tài khoản và Telegram</a></li>
            <li><a href="/nang-cap">Nâng cấp</a></li>
          </ul>
        </nav>
        <nav aria-label="Thông tin">
          <h2>Thông tin</h2>
          <ul>
            <li><a href="/bang-gia">Bảng giá</a></li>
            <li><a href="/dieu-khoan">Điều khoản</a></li>
            <li><a href="/bao-mat">Bảo mật</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    {
      app && (
        <nav class="tabbar" aria-label="Điều hướng nhanh">
          {tabs.map((t) => (
            <a href={t.href} aria-current={isCurrent(t) ? 'page' : undefined}>
              <Icon name={t.icon} size={22} />
              <span>{t.label}</span>
            </a>
          ))}
        </nav>
      )
    }
    <a class="tg-fab" href="/telegram" rel="nofollow" aria-label="Chat với bot Telegram của EPC: sửa câu, nhắc học, hỗ trợ">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"
        ><path
          fill="currentColor"
          d="M21.9 4.3 18.8 19c-.2 1-.8 1.3-1.7.8l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.8 8.7-7.9c.4-.3-.1-.5-.6-.2L6.8 12.9 2.2 11.5c-1-.3-1-1 .2-1.5l18-6.9c.8-.3 1.6.2 1.5 1.2Z"
        ></path></svg
      >
      <span class="tg-fab-label">Chat với bot</span>
    </a>
    {app && <ProgressSync />}
    <script>
      import { trackPage } from '../lib/events/client';
      trackPage();
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        const isDark = () =>
          root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const word = btn.querySelector('.theme-word');
        const label = () => {
          const next = isDark() ? 'sáng' : 'tối';
          if (word) word.textContent = next;
          btn.setAttribute('aria-label', `Giao diện ${next}`);
        };
        btn.hidden = false;
        label();
        btn.addEventListener('click', () => {
          const next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('epc:theme', next);
          } catch {}
          label();
        });
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
      })();
    </script>
  </body>
</html>
