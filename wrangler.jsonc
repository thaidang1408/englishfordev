{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "epc-app",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Workers AI cho tính năng sửa câu khi không có ANTHROPIC_API_KEY. Gói miễn phí: 10.000 neuron mỗi ngày.
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	}
}