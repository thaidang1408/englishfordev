{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "epc-app",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Workers AI cho tính năng sửa câu khi không có ANTHROPIC_API_KEY. Gói miễn phí: 10.000 neuron mỗi ngày.
	"ai": {
		"binding": "AI"
	},
	// Giới hạn POST /api/events theo IP: 60 lần mỗi phút. namespace_id là số tự chọn, duy nhất trong tài khoản.
	"ratelimits": [
		{
			"name": "EVENTS_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		}
	],
	"observability": {
		"enabled": true
	}
}